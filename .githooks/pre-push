#!/bin/sh
# Blocks a push when any commit about to be pushed adds private data or
# carries a personal email address in its author/committer metadata.
# git passes "<local ref> <local sha> <remote ref> <remote sha>" lines on stdin.
# Activate once per clone with: npm run setup:hooks
remote="$1"
root=$(git rev-parse --show-toplevel) || exit 1

if ! command -v node >/dev/null 2>&1; then
    echo "pre-push: node not found; the privacy check cannot run." >&2
    echo "Install Node >= 18 (or fix PATH for your git client) and push again." >&2
    exit 1
fi

# all-zero object id of this repository's hash length (SHA-1 or SHA-256)
zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "$local_sha" ] || continue
    # deleting a remote ref pushes no commits
    [ "$local_sha" = "$zero" ] && continue

    # Every commit the remote tip does not contain, except commits already on
    # another remote (e.g. upstream commits merged into this fork, which are
    # public there). Commits on other branches of the destination remote are
    # checked again: pushing them here must not spread a known problem.
    range="$local_sha --not --exclude=$remote/* --remotes"
    if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        range="$range $remote_sha"
    fi

    echo "pre-push: privacy check of $local_ref -> $remote_ref"
    node "$root/scripts/check-privacy.mjs" --history "$range" </dev/null || status=1
done

if [ "$status" -ne 0 ]; then
    echo "pre-push: push blocked by the privacy check (see CLAUDE.md, \"Privacy rules\")." >&2
fi
exit $status
