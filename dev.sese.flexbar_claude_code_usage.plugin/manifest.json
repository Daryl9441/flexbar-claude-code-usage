{
    "name": "Claude Code Usage",
    "uuid": "dev.sese.flexbar_claude_code_usage",
    "version": "0.4.0",
    "author": "Sese-Schneider",
    "entry": "backend/plugin.cjs",
    "description": "Display your Claude Code usage limits on your Flexbar",
    "repo": "https://github.com/Sese-Schneider/flexbar-claude-code-usage",
    "sdk": {
        "version": "1.0.0"
    },
    "software": {
        "minimumVersion": "1.0.0"
    },
    "os": [
        {
            "platform": "mac",
            "minimumVersion": "10.15"
        },
        {
            "platform": "windows",
            "minimumVersion": "10"
        },
        {
            "platform": "linux",
            "minimumVersion": "20.04"
        }
    ],
    "device": [
        {
            "name": "flexbar",
            "version": "1.0.0"
        }
    ],
    "configPage": "global_config",
    "keyLibrary": {
        "title": "$PluginName",
        "style": {
            "icon": "data:image/png;base64,"
        },
        "children": [
            {
                "title": "$Usage.Title",
                "tip": "$Usage.Tip",
                "cid": "dev.sese.flexbar_claude_code_usage.usage",
                "config": {
                    "keyType": "default",
                    "clickable": true,
                    "platform": [
                        "windows",
                        "mac",
                        "linux"
                    ]
                },
                "style": {
                    "icon": "data:image/png;base64,",
                    "width": 240
                },
                "data": {
                    "metric": "session",
                    "showResetTime": true,
                    "showClawd": false
                }
            },
            {
                "title": "$Session.Title",
                "tip": "$Session.Tip",
                "cid": "dev.sese.flexbar_claude_code_usage.session",
                "config": {
                    "keyType": "default",
                    "clickable": true,
                    "platform": [
                        "windows",
                        "mac",
                        "linux"
                    ]
                },
                "style": {
                    "icon": "mdi mdi-progress-question",
                    "width": 240
                },
                "data": {
                    "projectFilter": "",
                    "idleMinutes": 15,
                    "showProject": true,
                    "showClawd": false
                }
            },
            {
                "title": "$NewSession.Title",
                "tip": "$NewSession.Tip",
                "cid": "dev.sese.flexbar_claude_code_usage.newsession",
                "config": {
                    "keyType": "default",
                    "clickable": true,
                    "platform": [
                        "windows",
                        "mac",
                        "linux"
                    ]
                },
                "style": {
                    "icon": "data:image/png;base64,",
                    "width": 120
                },
                "data": {
                    "folder": ""
                }
            }
        ]
    },
    "local": {
        "en": {
            "PluginName": "Claude Code Usage",
            "Usage": {
                "Title": "Usage Meter",
                "Tip": "Shows a Claude Code usage limit as a live meter",
                "UI": {
                    "metric": "Usage limit",
                    "metricSession": "Session (5 hours)",
                    "metricWeekly": "Weekly (all models)",
                    "metricWeeklyModel": "Weekly (per model)",
                    "showResetTime": "Show time until reset",
                    "showClawd": "Show Clawd"
                }
            },
            "Config": {
                "Description": "Reads your Claude Code login from this computer and shows your usage limits. Log in with Claude Code once and it works — no API key needed.",
                "CredentialsPath": "Credentials file (optional override)",
                "PollInterval": "Refresh interval (seconds)",
                "Checking": "Checking…",
                "Connected": "Connected — session {session}%, week {weekly}%",
                "Disconnected": "Disconnected",
                "Saved": "Config updated",
                "ClaudeDir": "Claude Code folder for Session Status keys (optional)"
            },
            "Session": {
                "Title": "Session Status",
                "Tip": "Shows whether your latest Claude Code session is working, done, or waiting for you; press to list running sessions",
                "UI": {
                    "projectFilter": "Project filter",
                    "projectFilterHint": "Part of the project path; leave empty for the latest session of any project",
                    "idleMinutes": "Idle after (minutes)",
                    "lang": "Key text language",
                    "showProject": "Show project name",
                    "showClawd": "Show Clawd",
                    "checking": "Looking for sessions…",
                    "found": "Now showing: {project} — {state}",
                    "notFound": "No Claude Code session found in {dir}"
                },
                "State": {
                    "working": "working",
                    "question": "waiting for an answer",
                    "plan": "plan ready for review",
                    "permission": "waiting for permission",
                    "done": "done",
                    "interrupted": "interrupted",
                    "error": "error",
                    "idle": "idle"
                }
            },
            "NewSession": {
                "Title": "New Session",
                "Tip": "Opens a new Claude Code session in the Claude app",
                "UI": {
                    "folder": "Project folder (optional)",
                    "folderHint": "Absolute path or ~/…; leave empty to let the Claude app choose",
                    "lang": "Key text language"
                }
            }
        },
        "zh-CN": {
            "PluginName": "Claude Code 用量",
            "Usage": {
                "Title": "用量仪表",
                "Tip": "以实时仪表显示 Claude Code 的用量限制",
                "UI": {
                    "metric": "用量限制",
                    "metricSession": "会话（5 小时）",
                    "metricWeekly": "每周（所有模型）",
                    "metricWeeklyModel": "每周（按模型）",
                    "showResetTime": "显示距重置的时间",
                    "showClawd": "显示 Clawd"
                }
            },
            "Config": {
                "Description": "读取本机的 Claude Code 登录信息并显示用量限制。只需用 Claude Code 登录一次即可使用，无需 API 密钥。",
                "CredentialsPath": "凭据文件（可选，覆盖默认路径）",
                "PollInterval": "刷新间隔（秒）",
                "Checking": "正在检查…",
                "Connected": "已连接 — 会话 {session}%，本周 {weekly}%",
                "Disconnected": "未连接",
                "Saved": "配置已更新",
                "ClaudeDir": "会话状态按键使用的 Claude Code 目录（可选）"
            },
            "Session": {
                "Title": "会话状态",
                "Tip": "显示最新的 Claude Code 会话是在进行中、已完成，还是在等你；按下可列出运行中的会话",
                "UI": {
                    "projectFilter": "项目筛选",
                    "projectFilterHint": "项目路径的一部分；留空则显示所有项目中最新的会话",
                    "idleMinutes": "多久后视为空闲（分钟）",
                    "lang": "按键文字语言",
                    "showProject": "显示项目名",
                    "showClawd": "显示 Clawd",
                    "checking": "正在查找会话…",
                    "found": "当前显示：{project} — {state}",
                    "notFound": "在 {dir} 中没有找到 Claude Code 会话"
                },
                "State": {
                    "working": "进行中",
                    "question": "等待回答",
                    "plan": "计划待审",
                    "permission": "等待授权",
                    "done": "已完成",
                    "interrupted": "已中断",
                    "error": "出错",
                    "idle": "空闲"
                }
            },
            "NewSession": {
                "Title": "新建会话",
                "Tip": "在 Claude App 中打开新的 Claude Code 会话",
                "UI": {
                    "folder": "项目文件夹（可选）",
                    "folderHint": "绝对路径或 ~/…；留空则由 Claude App 选择",
                    "lang": "按键文字语言"
                }
            }
        }
    }
}
