{
    "name": "AI Coding Usage",
    "uuid": "dev.sese.flexbar_claude_code_usage",
    "version": "0.4.0",
    "author": "Sese-Schneider",
    "entry": "backend/plugin.cjs",
    "description": "Display your Claude Code, Kimi and Gemini usage limits and sessions on your Flexbar",
    "repo": "https://github.com/Sese-Schneider/flexbar-claude-code-usage",
    "sdk": {
        "version": "1.0.0"
    },
    "software": {
        "minimumVersion": "1.0.0"
    },
    "os": [
        {
            "platform": "mac",
            "minimumVersion": "10.15"
        },
        {
            "platform": "windows",
            "minimumVersion": "10"
        },
        {
            "platform": "linux",
            "minimumVersion": "20.04"
        }
    ],
    "device": [
        {
            "name": "flexbar",
            "version": "1.0.0"
        }
    ],
    "configPage": "global_config",
    "keyLibrary": {
        "title": "$PluginName",
        "style": {
            "icon": "data:image/png;base64,"
        },
        "children": [
            {
                "title": "$Usage.Title",
                "tip": "$Usage.Tip",
                "cid": "dev.sese.flexbar_claude_code_usage.usage",
                "config": {
                    "keyType": "default",
                    "clickable": true,
                    "platform": [
                        "windows",
                        "mac",
                        "linux"
                    ]
                },
                "style": {
                    "icon": "data:image/png;base64,",
                    "width": 240
                },
                "data": {
                    "metric": "session",
                    "showResetTime": true,
                    "showClawd": false
                }
            },
            {
                "title": "$Session.Title",
                "tip": "$Session.Tip",
                "cid": "dev.sese.flexbar_claude_code_usage.session",
                "config": {
                    "keyType": "default",
                    "clickable": true,
                    "platform": [
                        "windows",
                        "mac",
                        "linux"
                    ]
                },
                "style": {
                    "icon": "mdi mdi-progress-question",
                    "width": 240
                },
                "data": {
                    "projectFilter": "",
                    "idleMinutes": 15,
                    "showProject": true,
                    "showClawd": false
                }
            },
            {
                "title": "$NewSession.Title",
                "tip": "$NewSession.Tip",
                "cid": "dev.sese.flexbar_claude_code_usage.newsession",
                "config": {
                    "keyType": "default",
                    "clickable": true,
                    "platform": [
                        "windows",
                        "mac",
                        "linux"
                    ]
                },
                "style": {
                    "icon": "data:image/png;base64,",
                    "width": 120
                },
                "data": {
                    "folder": ""
                }
            },
            {
                "title": "$KimiUsage.Title",
                "tip": "$KimiUsage.Tip",
                "cid": "dev.sese.flexbar_claude_code_usage.kimi_usage",
                "config": {
                    "keyType": "default",
                    "clickable": true,
                    "platform": [
                        "windows",
                        "mac",
                        "linux"
                    ]
                },
                "style": {
                    "icon": "mdi mdi-gauge",
                    "width": 240
                },
                "data": {
                    "metric": "",
                    "showResetTime": true,
                    "showMark": true
                }
            },
            {
                "title": "$KimiSession.Title",
                "tip": "$KimiSession.Tip",
                "cid": "dev.sese.flexbar_claude_code_usage.kimi_session",
                "config": {
                    "keyType": "default",
                    "clickable": true,
                    "platform": [
                        "windows",
                        "mac",
                        "linux"
                    ]
                },
                "style": {
                    "icon": "mdi mdi-progress-question",
                    "width": 240
                },
                "data": {
                    "projectFilter": "",
                    "idleMinutes": 15,
                    "showProject": true,
                    "showMark": true,
                    "source": "auto",
                    "includeAutomations": false
                }
            },
            {
                "title": "$KimiNewSession.Title",
                "tip": "$KimiNewSession.Tip",
                "cid": "dev.sese.flexbar_claude_code_usage.kimi_newsession",
                "config": {
                    "keyType": "default",
                    "clickable": true,
                    "platform": [
                        "windows",
                        "mac",
                        "linux"
                    ]
                },
                "style": {
                    "icon": "mdi mdi-plus-circle-outline",
                    "width": 120
                },
                "data": {
                    "folder": "",
                    "target": "auto",
                    "cliMode": "new"
                }
            },
            {
                "title": "$GeminiUsage.Title",
                "tip": "$GeminiUsage.Tip",
                "cid": "dev.sese.flexbar_claude_code_usage.gemini_usage",
                "config": {
                    "keyType": "default",
                    "clickable": true,
                    "platform": [
                        "windows",
                        "mac",
                        "linux"
                    ]
                },
                "style": {
                    "icon": "mdi mdi-gauge",
                    "width": 240
                },
                "data": {
                    "metric": "",
                    "showResetTime": true,
                    "showMark": true
                }
            },
            {
                "title": "$GeminiSession.Title",
                "tip": "$GeminiSession.Tip",
                "cid": "dev.sese.flexbar_claude_code_usage.gemini_session",
                "config": {
                    "keyType": "default",
                    "clickable": true,
                    "platform": [
                        "windows",
                        "mac",
                        "linux"
                    ]
                },
                "style": {
                    "icon": "mdi mdi-progress-question",
                    "width": 240
                },
                "data": {
                    "projectFilter": "",
                    "idleMinutes": 15,
                    "showProject": true,
                    "showMark": true,
                    "liveDetection": true
                }
            },
            {
                "title": "$GeminiNewSession.Title",
                "tip": "$GeminiNewSession.Tip",
                "cid": "dev.sese.flexbar_claude_code_usage.gemini_newsession",
                "config": {
                    "keyType": "default",
                    "clickable": true,
                    "platform": [
                        "windows",
                        "mac",
                        "linux"
                    ]
                },
                "style": {
                    "icon": "mdi mdi-plus-circle-outline",
                    "width": 120
                },
                "data": {
                    "folder": "",
                    "target": "terminal-cli",
                    "resume": false,
                    "approvalMode": "default"
                }
            }
        ]
    },
